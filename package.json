{
    "name": "@nera-static/plugin-navigation",
    "version": "2.3.0",
    "description": "A plugin for Nera static site generator to generate navigations with optional templates and mixins.",
    "main": "index.js",
    "scripts": {
        "publish-template": "node ./bin/publish-template.js",
        "lint": "eslint .",
        "test": "vitest",
        "prepare": "husky"
    },
    "type": "module",
    "exports": {
        ".": "./index.js"
    },
    "bin": {
        "nera-navigation": "./bin/publish-template.js"
    },
    "files": [
        "bin",
        "config",
        "index.js",
        "views",
        "CHANGELOG.md"
    ],
    "keywords": [
        "nera",
        "plugin",
        "navigation",
        "static-site",
        "mixin",
        "template"
    ],
    "author": "Michael Becker",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/seebaermichi/nera-plugin-navigation.git"
    },
    "bugs": {
        "url": "https://github.com/seebaermichi/nera-plugin-navigation/issues"
    },
    "homepage": "https://github.com/seebaermichi/nera-plugin-navigation#readme",
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@nera-static/plugin-utils": "^1.2.0"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "devDependencies": {
        "cheerio": "^1.1.0",
        "eslint": "^9.17.0",
        "husky": "^9.1.7",
        "pug": "^3.0.3",
        "vitest": "^3.2.4"
    },
    "sideEffects": false
}
